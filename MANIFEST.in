# Keep both supported quickstart entry points and the dependency contract in the
# source distribution.  Tests are intentionally shipped: the release workflow
# installs the sdist in isolation and runs this exact suite from the unpacked
# archive, including JSON fixtures that setuptools does not discover by default.
include degora_quickstart.sh
include scripts/degora_quickstart.sh
include requirements.txt
include CHANGELOG.md
include .gitattributes
include .gitignore
recursive-include tests *.py *.json
# Keep the high-risk public-discovery regression suite explicit as well as
# covered by the recursive test rule, so its accidental removal is visible.
include tests/test_live_discovery_regressions.py
include Makefile
include LICENSE
